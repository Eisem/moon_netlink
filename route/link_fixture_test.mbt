///|
/// Real NLMSG_DONE captured from the same RTM_GETLINK dump shape.
fn real_done_message() -> Bytes {
  [
    0x14, 0x00, 0x00, 0x00, 0x03, 0x00, 0x02, 0x00, 0x92, 0x10, 0x00, 0x00, 0x16,
    0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  ]
}

///|
test "real Linux multipart fixtures include data and completion" {
  let data = @core.decode_datagram(real_loopback_message())[0]
  let done = @core.decode_datagram(real_done_message())[0]
  assert_eq(data.header.sequence, 4242)
  assert_eq(done.header.sequence, 4242)
  assert_eq(data.header.flags & 2, 2)
  assert_eq(done.header.flags & 2, 2)
  assert_eq(@core.decode_control(done), Some(Done(Some(0))))
}

///|
test "decode real Linux loopback fixture" {
  let messages = @core.decode_datagram(real_loopback_message())
  assert_eq(messages.length(), 1)
  let message = messages[0]
  assert_eq(message.header.message_type, @route.rtm_newlink)
  assert_eq(message.header.sequence, 4242)
  let link = @route.decode_link(message)
  assert_eq(link.index, 1)
  assert_eq(link.name, Some("lo"))
  assert_eq(link.kind, None)
  assert_eq(link.mtu, Some(65536))
  guard link.mac is Some(mac) else {
    fail("expected loopback link-layer address")
  }
  assert_eq(mac.to_string(), "00:00:00:00:00:00")
  assert_eq(link.flags, 0x10049)
  assert_eq(link.operational_state, Some(Unknown))
  assert_eq(link.master_index, None)
  assert_true(link.unknown_attributes.length() > 0)
}

///|
test "real Linux fixture survives semantic message roundtrip" {
  let original = @core.decode_datagram(real_loopback_message())[0]
  let decoded = @core.decode_datagram(@core.encode_message(original))[0]
  assert_eq(decoded, original)
}
